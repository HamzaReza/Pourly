{
  "name": "pourly-firebase-rules",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore security rules tests (Vitest + @firebase/rules-unit-testing) and the Firebase CLI for the emulator. Needs Java 21+.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "emulators": "firebase emulators:start --only firestore --project demo-pourly --config ../firebase.json",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pourly --config ../firebase.json \"vitest run\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.37.0",
    "vitest": "^4"
  }
}
