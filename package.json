{
  "name": "pourly",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/grandstander": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-system-ui": "~58.0.7",
    "firebase": "^12.19.0",
    "i18next": "^27.2.7",
    "react": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-purchases": "^11.0.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "opentype.js": "^2.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "test-renderer": "^1.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci",
    "format": "prettier --write .",
    "gen:levels": "tsx scripts/generate-levels.ts",
    "gen:sounds": "node scripts/generate-sounds.mjs",
    "gen:assets": "node scripts/generate-assets.mjs",
    "gen:all": "yarn gen:levels && yarn gen:sounds && yarn gen:assets",
    "doctor": "npx expo-doctor",
    "export:android": "expo export --platform android",
    "prebuild:android": "expo prebuild --no-install --platform android --clean",
    "postinstall": "patch-package",
    "build": "eas build -p android --profile production --local --output dist/pourly.aab",
    "preview": "eas build -p android --profile preview --local --output dist/pourly-preview.apk",
    "submit": "eas submit -p android --profile production --path dist/pourly.aab",
    "release": "yarn build && yarn submit"
  },
  "private": true
}
